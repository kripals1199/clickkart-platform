# .env.dev-infra.example
#
# Copy to .env when running the app tier against the local Tier-3 stand-ins:
#   cp .env.dev-infra.example .env
#   docker compose -f docker-compose.dev-infra.yml -f docker-compose.app-tier.yml up -d
#
# These values point at the container names defined in docker-compose.dev-infra.yml. They are
# NOT defaults baked into docker-compose.app-tier.yml itself - that file still fails fast with
# no .env present, which is the point: nothing about the application tier's compose file should
# make it look like it works without a Tier-3 endpoint being deliberately supplied.

SPRING_PROFILES_ACTIVE=dev

CONFIG_SERVER_PASSWORD=dev-only-secret-change-me
EUREKA_DASHBOARD_PASSWORD=dev-only-secret-change-me
GATEWAY_ADMIN_PASSWORD=dev-only-secret-change-me
AUTH_SERVICE_ADMIN_PASSWORD=dev-only-secret-change-me
JWT_SECRET=dev-only-secret-change-me-please-32bytes-minimum

# Points at a real, already-installed native PostgreSQL instance on the host machine - not a
# container (see docker-compose.dev-infra.yml's header comment for why Postgres isn't
# containerized here). host.docker.internal is Docker Desktop's built-in DNS name for reaching
# the host from inside a container; "localhost" would resolve to the container itself instead.
#
# Each service must connect with its OWN dedicated, least-privilege Postgres role - never the
# postgres superuser. On your native instance, create one role per service, make it the owner of
# exactly that service's database, and revoke CONNECT from PUBLIC on the other two databases so
# a leaked credential for one service can't even open a connection to another's data:
#   CREATE ROLE clickkart_auth_app         WITH LOGIN PASSWORD '...';
#   CREATE ROLE clickkart_notification_app WITH LOGIN PASSWORD '...';
#   CREATE ROLE clickkart_audit_log_app    WITH LOGIN PASSWORD '...';
#   ALTER DATABASE clickkart_auth         OWNER TO clickkart_auth_app;
#   ALTER DATABASE clickkart_notification OWNER TO clickkart_notification_app;
#   ALTER DATABASE clickkart_audit_log    OWNER TO clickkart_audit_log_app;
#   -- then, per database: GRANT ALL PRIVILEGES ON ALL TABLES/SEQUENCES IN SCHEMA public TO <role>;
#   --                     ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES/SEQUENCES TO <role>;
#   --                     REVOKE CONNECT ON DATABASE <other-two> FROM PUBLIC;
# Real passwords belong only in your local .env (gitignored), never in this example file.
AUTH_DB_HOST=host.docker.internal
AUTH_DB_USERNAME=clickkart_auth_app
AUTH_DB_PASSWORD=CHANGE_ME

NOTIFICATION_DB_HOST=host.docker.internal
NOTIFICATION_DB_USERNAME=clickkart_notification_app
NOTIFICATION_DB_PASSWORD=CHANGE_ME

AUDIT_LOG_DB_HOST=host.docker.internal
AUDIT_LOG_DB_USERNAME=clickkart_audit_log_app
AUDIT_LOG_DB_PASSWORD=CHANGE_ME

GATEWAY_REDIS_HOST=gateway-redis

# Own Redis for captcha-service - see docker-compose.dev-infra.yml's captcha-redis service for
# why this isn't just gateway-redis reused. Host port distinct from gateway-redis's 6379 mapping
# to avoid the same collision class fixed for the Postgres containers above.
CAPTCHA_REDIS_HOST=captcha-redis
CAPTCHA_REDIS_HOST_PORT=6380
