# https://editorconfig.org - keeps formatting consistent across IDEs (this project is developed
# in both Eclipse and VS Code; Java sources here are tab-indented, everything else spaces).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.{xml,properties}]
indent_style = space
indent_size = 4

[*.md]
# Trailing whitespace is significant in Markdown (line break).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
